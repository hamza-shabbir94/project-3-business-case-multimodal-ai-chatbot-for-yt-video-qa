{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "routes": [
        {
          "handle": "filesystem"
        },
        {
          "src": "/(.*)",
          "dest": "/404.html",
          "status": 404
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,pytest.ini,openapi.json,**/__pycache__/**}"
        }
      }
    }
  },
  "redirects": [
    {
      "source": "/chat",
      "destination": "/chat/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
