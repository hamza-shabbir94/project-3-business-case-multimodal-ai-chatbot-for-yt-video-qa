# Copy this file to .env and fill in your own values. Never commit .env.

# OpenAI (Ironhack key)
OPENAI_API_KEY=your-openai-key-here

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=yt-video-qa

# Pinecone (used from phase 2)
PINECONE_API_KEY=your-pinecone-key-here

# Neon Postgres for agent memory (used from phase 4)
DATABASE_URL=your-neon-url-here
